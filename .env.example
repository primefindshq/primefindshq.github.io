# PRIME.FINDS — environment variables
#
# The current static build reads no secrets and needs no env vars to run.
# This file documents what the NEXT phases of the project will need, so the
# shape is agreed on ahead of time. Copy to `.env` (or your host's env
# settings) and fill in real values when these integrations are added.
# Never commit a real `.env` file.

# --- Analytics (see public/js/core/analytics.js) ---------------------------
# Provider to activate: "none" | "ga4" | "plausible"
ANALYTICS_PROVIDER=none
# GA4 measurement ID, e.g. G-XXXXXXX (only used when ANALYTICS_PROVIDER=ga4)
ANALYTICS_ID=

# --- Future: automated Product Hunter + admin dashboard ---------------------
# API key(s) for whichever product/affiliate data source(s) get connected
# (e.g. Amazon Product Advertising API, another affiliate network API).
# PRODUCT_SOURCE_API_KEY=
# PRODUCT_SOURCE_API_SECRET=

# Auth for the future /admin dashboard (approve/reject/edit products).
# ADMIN_SESSION_SECRET=

# Database connection string, once product data moves off static JSON files
# (see data/products.json) into a real database.
# DATABASE_URL=
